# ==============================================================================
# PhishGuard Enterprise Security Hub — Production Environment Configuration
# ==============================================================================
#
# Configure these variables in your Vercel Project Settings:
#   Project Dashboard -> Settings -> Environment Variables
#
# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Server-only)
# ------------------------------------------------------------------------------
# PostgreSQL / Supabase connection string. For Supabase or Neon on Vercel,
# use the connection pooling string (port 6543 for Supabase):
# e.g., postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Supabase REST API credentials (alternative or paired with DATABASE_URL)
# e.g., https://[project-ref].supabase.co
SUPABASE_URL=
# Server-only service_role key or publishable key
SUPABASE_KEY=

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE SUPABASE CONFIGURATION (Public)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. PRODUCTION HOST CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# In Vercel deployments, VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL are automatically
# detected. If using a custom enterprise domain (e.g., https://security.mycorp.com),
# set APP_URL here:
APP_URL=
NEXT_PUBLIC_APP_URL=
